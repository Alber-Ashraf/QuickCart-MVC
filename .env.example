# QuickCart Environment Configuration
# Copy this file to .env and adjust variables as needed

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Database Configuration (SQL Server)
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=QuickCart;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;MultipleActiveResultSets=True;

# Stripe Configuration
Stripe__SecretKey=sk_test_YOUR_STRIPE_SECRET_KEY
Stripe__PublishableKey=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# Backblaze B2 S3-Compatible Storage Configuration
Backblaze__BucketName=flyleaf-books
Backblaze__Region=us-east-005
Backblaze__AccessKey=YOUR_BACKBLAZE_KEY_ID
Backblaze__SecretKey=YOUR_BACKBLAZE_APPLICATION_KEY
Backblaze__Endpoint=https://s3.us-east-005.backblazeb2.com

# OAuth Settings (Google)
OAuthSettings__GoogleClientId=YOUR_GOOGLE_CLIENT_ID
OAuthSettings__GoogleClientSecret=YOUR_GOOGLE_CLIENT_SECRET

# Facebook External Authentication (Optional)
Authentication__Facebook__AppId=
Authentication__Facebook__AppSecret=

# Seed Administrator
AdminUser__Email=admin@quickcart.com
AdminUser__Password=AdminPassword123!
