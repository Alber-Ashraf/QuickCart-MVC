@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Views/Shared/_Layout.cshtml";
    }
}

<div class="py-2">
    <div class="qc-page-header mb-4">
        <div class="page-header-info">
            <h1 class="page-title">
                <i class="bi bi-person-gear me-2 text-primary"></i> Account Settings
            </h1>
            <p class="page-subtitle">Manage your profile details, security preferences, and personal data.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Side Navigation -->
        <div class="col-lg-3">
            <div class="qc-card p-3">
                <partial name="_ManageNav" />
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="qc-card p-4">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
