@model UserVM

@{
    ViewData["Title"] = $"Manage Permissions: {Model.ApplicationUser.Name}";
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="User" asp-action="Index">Governance</a>
    <span class="separator">/</span>
    <span class="current">Role & Permissions</span>
}

<div class="user-permissions-container py-2 d-flex justify-content-center">
    <div class="qc-card p-4 p-md-5" style="max-width: 600px; width: 100%;">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="empty-state-icon-circle bg-primary-subtle text-primary" style="width: 48px; height: 48px;">
                <i class="bi bi-shield-lock fs-4"></i>
            </div>
            <div>
                <h1 class="fs-5 fw-bold text-primary mb-1">Manage Role & Permissions</h1>
                <p class="small text-muted mb-0">Update directory role assignment and company affiliations.</p>
            </div>
        </div>

        <form asp-action="ManagePermission" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ApplicationUser.Id" />

            <!-- User Name (Readonly) -->
            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted">User Account Name</label>
                <div class="input-icon-group">
                    <i class="bi bi-person input-prefix-icon"></i>
                    <input asp-for="ApplicationUser.Name" class="form-control qc-input bg-subtle" readonly />
                </div>
            </div>

            <!-- Role Dropdown -->
            <div class="mb-3">
                <label asp-for="ApplicationUser.Role" class="form-label small fw-semibold text-secondary">
                    Authorization Role <span class="text-danger">*</span>
                </label>
                <div class="input-icon-group">
                    <i class="bi bi-shield-shaded input-prefix-icon"></i>
                    <select asp-for="ApplicationUser.Role" asp-items="@Model.Role_List" class="form-select qc-input" id="roleSelect">
                        <option disabled selected>Select an authorization role</option>
                    </select>
                </div>
                <span asp-validation-for="ApplicationUser.Role" class="text-danger small"></span>
            </div>

            <!-- Company Dropdown (Conditional) -->
            <div class="mb-4" id="companySelectContainer" style="display:none;">
                <label asp-for="ApplicationUser.CompanyId" class="form-label small fw-semibold text-secondary">
                    Corporate Account Affiliation <span class="text-danger">*</span>
                </label>
                <div class="input-icon-group">
                    <i class="bi bi-building input-prefix-icon"></i>
                    <select asp-for="ApplicationUser.CompanyId" asp-items="@Model.Company_List" class="form-select qc-input">
                        <option disabled selected>Select Corporate Account</option>
                    </select>
                </div>
                <span asp-validation-for="ApplicationUser.CompanyId" class="text-danger small"></span>
                <div class="form-text small text-muted">Links this user to corporate Net 30 invoicing terms.</div>
            </div>

            <div class="d-flex gap-2 justify-content-end pt-3 border-top border-subtle">
                <a asp-action="Index" class="btn btn-outline-secondary qc-btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary qc-btn-primary" data-loading-text="Saving...">
                    <i class="bi bi-check2 me-1"></i> Update Permissions
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function toggleCompanySelect() {
                if ($('#roleSelect').val() === 'Company') {
                    $('#companySelectContainer').slideDown(150);
                } else {
                    $('#companySelectContainer').slideUp(150);
                }
            }

            $('#roleSelect').on('change', toggleCompanySelect);
            toggleCompanySelect();
        });
    </script>
}
