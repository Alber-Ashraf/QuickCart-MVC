@using QuickCart.Models.ViewModels

@{
    ViewData["Title"] = "User Governance";
    var pageHeader = new PageHeaderVM
    {
        Title = "User Governance",
        Subtitle = "Manage identity accounts, role-based authorization, account lockouts, and enterprise company affiliations.",
        IconClass = "bi bi-people-fill",
        ActionText = "Register User",
        ActionUrl = "/Identity/Account/Register",
        ActionIcon = "bi bi-person-plus-fill"
    };
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="User" asp-action="Index">Governance</a>
    <span class="separator">/</span>
    <span class="current">Users</span>
}

<div class="user-management-container py-2">
    <partial name="_PageHeader" model="@pageHeader" />

    <div class="qc-card overflow-hidden">
        <div class="p-3 bg-surface-hover border-bottom border-subtle d-flex justify-content-between align-items-center">
            <span class="small fw-bold text-uppercase text-muted letter-spacing-wide">
                <i class="bi bi-shield-check me-1 text-primary"></i> Directory Accounts
            </span>
            <span class="small text-muted font-mono">Role-Based Access Control</span>
        </div>

        <div class="p-3">
            <div class="table-responsive">
                <table id="tblData" class="qc-table w-100">
                    <thead>
                        <tr>
                            <th>User Name</th>
                            <th>Email Address</th>
                            <th>Phone Number</th>
                            <th>Company</th>
                            <th>Assigned Role</th>
                            <th class="text-center">Security Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Asynchronously loaded by user.js via /Admin/User/GetAll -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/user.js" asp-append-version="true"></script>
}
