@using QuickCart.Models.ViewModels

@{
    ViewData["Title"] = "Order Management";
    var status = Context.Request.Query["status"].ToString().ToLower();
    if (string.IsNullOrEmpty(status)) status = "all";

    var pageHeader = new PageHeaderVM
    {
        Title = "Order Management",
        Subtitle = "Track customer fulfillment, corporate invoices, carrier shipments, and payment captures.",
        IconClass = "bi bi-receipt"
    };
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Order" asp-action="Index">Operations</a>
    <span class="separator">/</span>
    <span class="current">Orders</span>
}

<div class="order-management-container py-2">
    <partial name="_PageHeader" model="@pageHeader" />

    <div class="qc-card overflow-hidden">
        <!-- Segmented Status Tabs Bar -->
        <div class="p-3 bg-surface-hover border-bottom border-subtle d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="small text-muted fw-semibold me-1">
                    <i class="bi bi-funnel me-1"></i> Filter Status:
                </span>
                <a asp-action="Index" asp-route-status="all"
                   class="btn btn-sm @(status == "all" ? "btn-primary qc-btn-primary" : "btn-outline-secondary qc-btn-secondary") rounded-pill px-3">
                    <i class="bi bi-list-ul me-1"></i> All Orders
                </a>
                <a asp-action="Index" asp-route-status="inprocess"
                   class="btn btn-sm @(status == "inprocess" ? "btn-primary qc-btn-primary" : "btn-outline-secondary qc-btn-secondary") rounded-pill px-3">
                    <i class="bi bi-arrow-repeat me-1"></i> In Process
                </a>
                <a asp-action="Index" asp-route-status="pending"
                   class="btn btn-sm @(status == "pending" ? "btn-primary qc-btn-primary" : "btn-outline-secondary qc-btn-secondary") rounded-pill px-3">
                    <i class="bi bi-hourglass-split me-1"></i> Pending
                </a>
                <a asp-action="Index" asp-route-status="approved"
                   class="btn btn-sm @(status == "approved" ? "btn-primary qc-btn-primary" : "btn-outline-secondary qc-btn-secondary") rounded-pill px-3">
                    <i class="bi bi-check2-circle me-1"></i> Approved
                </a>
                <a asp-action="Index" asp-route-status="completed"
                   class="btn btn-sm @(status == "completed" ? "btn-primary qc-btn-primary" : "btn-outline-secondary qc-btn-secondary") rounded-pill px-3">
                    <i class="bi bi-truck me-1"></i> Shipped / Completed
                </a>
            </div>

            <span class="small text-muted font-mono d-none d-md-inline">
                Real-time AJAX stream
            </span>
        </div>

        <div class="p-3">
            <div class="table-responsive">
                <table id="tblData" class="qc-table w-100">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Total Due</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Asynchronously loaded by order.js -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order.js" asp-append-version="true"></script>
}
