@model OrderVM

@{
    ViewData["Title"] = $"Order #{Model.OrderHeader.OrderHeaderId}";
    var isAdminOrEmployee = User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee);
    var isCompany = User.IsInRole(SD.Role_Company);
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Order" asp-action="Index">Orders</a>
    <span class="separator">/</span>
    <span class="current">#@Model.OrderHeader.OrderHeaderId</span>
}

<div class="order-details-container py-2">
    <!-- Action Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div>
                <h1 class="page-title mb-1">
                    <i class="bi bi-receipt text-primary me-2"></i> Order #@Model.OrderHeader.OrderHeaderId
                </h1>
                <p class="page-subtitle mb-0">
                    Placed on @Model.OrderHeader.OrderDate.ToString("MMMM dd, yyyy") by
                    <span class="fw-semibold text-secondary">@Model.OrderHeader.ApplicationUser?.Email</span>
                </p>
            </div>
            <partial name="_StatusBadge" model="@Model.OrderHeader.OrderStatus" />
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary qc-btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Orders
        </a>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="OrderHeader.OrderHeaderId" type="hidden" />

        <div class="row g-4">
            <!-- Left: Recipient & Fulfillment Specification -->
            <div class="col-lg-7">
                <!-- Recipient Card -->
                <div class="qc-card p-4 mb-4">
                    <h2 class="fs-6 fw-bold text-uppercase text-muted letter-spacing-wide mb-3">
                        <i class="bi bi-person-lines-fill me-1 text-primary"></i> Recipient & Destination Details
                    </h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Recipient Name</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.Name" class="form-control qc-input" />
                                <span asp-validation-for="OrderHeader.Name" class="text-danger small"></span>
                            }
                            else
                            {
                                <input asp-for="OrderHeader.Name" readonly class="form-control qc-input bg-subtle" />
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Contact Phone</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.PhoneNumber" class="form-control qc-input font-mono" />
                                <span asp-validation-for="OrderHeader.PhoneNumber" class="text-danger small"></span>
                            }
                            else
                            {
                                <input asp-for="OrderHeader.PhoneNumber" readonly class="form-control qc-input font-mono bg-subtle" />
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Street Address</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.Address" class="form-control qc-input" />
                                <span asp-validation-for="OrderHeader.Address" class="text-danger small"></span>
                            }
                            else
                            {
                                <input asp-for="OrderHeader.Address" readonly class="form-control qc-input bg-subtle" />
                            }
                        </div>

                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-secondary">City</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.City" class="form-control qc-input" />
                                <span asp-validation-for="OrderHeader.City" class="text-danger small"></span>
                            }
                            else
                            {
                                <input asp-for="OrderHeader.City" readonly class="form-control qc-input bg-subtle" />
                            }
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-secondary">State / Province</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.State" class="form-control qc-input" />
                                <span asp-validation-for="OrderHeader.State" class="text-danger small"></span>
                            }
                            else
                            {
                                <input asp-for="OrderHeader.State" readonly class="form-control qc-input bg-subtle" />
                            }
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-secondary">ZIP / Postal</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.PostalCode" class="form-control qc-input font-mono" />
                                <span asp-validation-for="OrderHeader.PostalCode" class="text-danger small"></span>
                            }
                            else
                            {
                                <input asp-for="OrderHeader.PostalCode" readonly class="form-control qc-input font-mono bg-subtle" />
                            }
                        </div>
                    </div>
                </div>

                <!-- Carrier & Fulfillment Logistics Card -->
                <div class="qc-card p-4 mb-4">
                    <h2 class="fs-6 fw-bold text-uppercase text-muted letter-spacing-wide mb-3">
                        <i class="bi bi-truck me-1 text-primary"></i> Logistics & Carrier Dispatch
                    </h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Shipping Carrier</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.Carrier" id="carrier" class="form-control qc-input" placeholder="e.g. FedEx, UPS, DHL" />
                            }
                            else
                            {
                                <input asp-for="OrderHeader.Carrier" readonly class="form-control qc-input bg-subtle" />
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Tracking Reference</label>
                            @if (isAdminOrEmployee)
                            {
                                <input asp-for="OrderHeader.TrackingNumber" id="trackingNumber" class="form-control qc-input font-mono" placeholder="Tracking #" />
                            }
                            else
                            {
                                <input asp-for="OrderHeader.TrackingNumber" readonly class="form-control qc-input font-mono bg-subtle" />
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Shipping Dispatch Date</label>
                            <input value="@(Model.OrderHeader.ShippingDate == default ? "Not yet shipped" : Model.OrderHeader.ShippingDate.ToString("yyyy-MM-dd"))"
                                   readonly class="form-control qc-input font-mono bg-subtle" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Payment Captured / Due</label>
                            @if (Model.OrderHeader.SessionId == null)
                            {
                                <input value="Due: @Model.OrderHeader.PaymentDueDate.ToString("yyyy-MM-dd")" readonly class="form-control qc-input font-mono bg-subtle" />
                            }
                            else
                            {
                                <input value="Paid: @Model.OrderHeader.PaymentDate.ToString("yyyy-MM-dd")" readonly class="form-control qc-input font-mono bg-subtle" />
                            }
                        </div>

                        @if (isAdminOrEmployee)
                        {
                            <div class="col-12 pt-2 border-top border-subtle">
                                <span class="small text-muted fw-bold text-uppercase d-block mb-2">Gateways & Telemetry</span>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="small text-muted">Stripe Session ID</label>
                                        <input asp-for="OrderHeader.SessionId" readonly class="form-control qc-input font-mono small bg-subtle" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="small text-muted">Payment Intent ID</label>
                                        <input asp-for="OrderHeader.PaymentIntentId" readonly class="form-control qc-input font-mono small bg-subtle" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 pt-2">
                                <button asp-action="UpdateOrderDetail" type="submit" class="btn btn-outline-secondary qc-btn-secondary w-100" data-loading-text="Saving Details...">
                                    <i class="bi bi-save me-1"></i> Update Order Details
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Order Items Manifest & Lifecycle Actions -->
            <div class="col-lg-5">
                <div class="qc-card p-4 sticky-top" style="top: 80px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="fs-6 fw-bold text-uppercase text-muted letter-spacing-wide mb-0">
                            <i class="bi bi-basket2 me-1 text-primary"></i> Order Manifest
                        </h2>
                        <span class="qc-badge qc-badge-accent">
                            Payment: @Model.OrderHeader.PaymentStatus
                        </span>
                    </div>

                    <!-- Line Items -->
                    <div class="manifest-list divide-y mb-3 overflow-auto" style="max-height: 300px;">
                        @foreach (var detail in Model.OrderDetail)
                        {
                            <div class="py-2 d-flex justify-content-between align-items-center gap-2">
                                <div class="text-truncate">
                                    <div class="fw-semibold text-primary small text-truncate" title="@detail.Product?.Title">
                                        @detail.Product?.Title
                                    </div>
                                    <span class="small text-muted font-mono">
                                        Qty: @detail.Count &times; @detail.Price.ToString("C")
                                    </span>
                                </div>
                                <span class="font-mono fw-bold text-secondary flex-shrink-0 small">
                                    @((detail.Count * detail.Price).ToString("C"))
                                </span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline mb-4 pt-3 border-top border-subtle">
                        <span class="fw-bold text-primary fs-6">Grand Total</span>
                        <span class="fs-4 fw-bold font-mono text-primary">
                            @Model.OrderHeader.OrderTotal.ToString("C")
                        </span>
                    </div>

                    <!-- Workflow Actions -->
                    <div class="d-flex flex-column gap-2">
                        @if (isCompany && Model.OrderHeader.PaymentStatus == SD.PaymentStatusDelayedPayment && Model.OrderHeader.OrderStatus == SD.StatusShipped)
                        {
                            <button type="submit" class="btn btn-primary qc-btn-primary py-2 justify-content-center" data-loading-text="Processing Payment...">
                                <i class="bi bi-credit-card-2-front me-2"></i> Pay Invoice Now
                            </button>
                        }

                        @if (isAdminOrEmployee)
                        {
                            @if (Model.OrderHeader.OrderStatus == SD.StatusApproved)
                            {
                                <button type="submit" asp-action="StartProcessing" class="btn btn-primary qc-btn-primary py-2 justify-content-center" data-loading-text="Updating...">
                                    <i class="bi bi-play-circle me-2"></i> Start Fulfillment Processing
                                </button>
                            }

                            @if (Model.OrderHeader.OrderStatus == SD.StatusInProcess)
                            {
                                <button type="submit" onclick="return validateInput()" asp-action="StartShipping" class="btn btn-success py-2 justify-content-center" data-loading-text="Dispatching...">
                                    <i class="bi bi-truck me-2"></i> Dispatch & Ship Order
                                </button>
                            }

                            @if (Model.OrderHeader.OrderStatus != SD.StatusRefunded &&
                                 Model.OrderHeader.OrderStatus != SD.StatusShipped &&
                                 Model.OrderHeader.OrderStatus != SD.StatusCancelled)
                            {
                                <button type="submit" asp-action="CancelOrder" name="action" value="CancelOrder" class="btn btn-outline-danger py-2 justify-content-center" onclick="return confirm('Cancel this order and refund customer?');">
                                    <i class="bi bi-x-circle me-2"></i> Cancel Order
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function validateInput() {
            const tracking = document.getElementById("trackingNumber")?.value?.trim();
            const carrier = document.getElementById("carrier")?.value?.trim();

            if (!carrier) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Carrier Required',
                    text: 'Please specify the shipping carrier (e.g., FedEx, UPS) before dispatching the order.'
                });
                return false;
            }

            if (!tracking) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Tracking Reference Required',
                    text: 'Please enter the carrier tracking reference before dispatching the order.'
                });
                return false;
            }

            return true;
        }
    </script>
}
