@model Company

@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? $"Edit: {Model.Name}" : "Create Corporate Account";
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Company" asp-action="Index">Governance</a>
    <span class="separator">/</span>
    <span class="current">@(isEdit ? "Edit Company" : "New Company")</span>
}

<div class="company-upsert-container py-2 d-flex justify-content-center">
    <div class="qc-card p-4 p-md-5" style="max-width: 720px; width: 100%;">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="empty-state-icon-circle bg-primary-subtle text-primary" style="width: 48px; height: 48px;">
                <i class="bi bi-buildings fs-4"></i>
            </div>
            <div>
                <h1 class="fs-5 fw-bold text-primary mb-1">
                    @(isEdit ? "Edit Corporate Account" : "Register Corporate Account")
                </h1>
                <p class="small text-muted mb-0">Configure business client legal details and invoicing address.</p>
            </div>
        </div>

        <form asp-action="Upsert" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label small fw-semibold text-secondary">
                        Company Legal Name <span class="text-danger">*</span>
                    </label>
                    <div class="input-icon-group">
                        <i class="bi bi-building input-prefix-icon"></i>
                        <input asp-for="Name" class="form-control qc-input" placeholder="e.g. Acme Corporation LLC" autofocus />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Phone" class="form-label small fw-semibold text-secondary">
                        Corporate Phone Number
                    </label>
                    <div class="input-icon-group">
                        <i class="bi bi-telephone input-prefix-icon"></i>
                        <input asp-for="Phone" class="form-control qc-input font-mono" placeholder="e.g. +1 (555) 234-5678" />
                    </div>
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label small fw-semibold text-secondary">
                        Headquarters Street Address
                    </label>
                    <div class="input-icon-group">
                        <i class="bi bi-geo-alt input-prefix-icon"></i>
                        <input asp-for="Address" class="form-control qc-input" placeholder="e.g. 500 Market Street, Suite 1200" />
                    </div>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="col-md-5">
                    <label asp-for="City" class="form-label small fw-semibold text-secondary">City</label>
                    <div class="input-icon-group">
                        <i class="bi bi-buildings input-prefix-icon"></i>
                        <input asp-for="City" class="form-control qc-input" placeholder="City" />
                    </div>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="State" class="form-label small fw-semibold text-secondary">State / Province</label>
                    <div class="input-icon-group">
                        <i class="bi bi-map input-prefix-icon"></i>
                        <input asp-for="State" class="form-control qc-input" placeholder="State" />
                    </div>
                    <span asp-validation-for="State" class="text-danger small"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="PostalCode" class="form-label small fw-semibold text-secondary">Postal Code</label>
                    <div class="input-icon-group">
                        <i class="bi bi-mailbox input-prefix-icon"></i>
                        <input asp-for="PostalCode" class="form-control qc-input font-mono" placeholder="ZIP" />
                    </div>
                    <span asp-validation-for="PostalCode" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end pt-4 mt-4 border-top border-subtle">
                <a asp-action="Index" class="btn btn-outline-secondary qc-btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary qc-btn-primary" data-loading-text="Saving...">
                    <i class="bi bi-check2 me-1"></i> @(isEdit ? "Update Company" : "Register Company")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
