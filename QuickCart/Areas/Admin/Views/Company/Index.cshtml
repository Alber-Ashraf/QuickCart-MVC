@model IEnumerable<Company>
@using QuickCart.Models.ViewModels

@{
    ViewData["Title"] = "Corporate Accounts";
    var pageHeader = new PageHeaderVM
    {
        Title = "Corporate Accounts",
        Subtitle = "Manage verified business clients, Net 30 delayed invoice privileges, and company profiles.",
        IconClass = "bi bi-buildings",
        ActionText = "New Company",
        ActionUrl = Url.Action("Upsert", "Company", new { area = "Admin" }),
        ActionIcon = "bi bi-plus-lg"
    };
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Company" asp-action="Index">Governance</a>
    <span class="separator">/</span>
    <span class="current">Companies</span>
}

<div class="company-management-container py-2">
    <partial name="_PageHeader" model="@pageHeader" />

    @if (Model != null && Model.Any())
    {
        <div class="qc-card overflow-hidden">
            <div class="p-3 bg-surface-hover border-bottom border-subtle d-flex justify-content-between align-items-center">
                <span class="small fw-bold text-uppercase text-muted letter-spacing-wide">
                    <i class="bi bi-briefcase me-1 text-primary"></i> Registered Corporate Entities
                </span>
                <span class="small text-muted font-mono">Net 30 eligible</span>
            </div>

            <div class="p-3">
                <div class="table-responsive">
                    <table id="tblData" class="qc-table w-100">
                        <thead>
                            <tr>
                                <th>Company Name</th>
                                <th>Phone Number</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Populated asynchronously by Company.js via /Admin/Company/GetAll -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        var emptyState = new EmptyStateVM
        {
            Title = "No corporate accounts found",
            Description = "There are currently no corporate accounts registered in Flyleaf. Add your first corporate client to enable Net 30 invoicing.",
            IconClass = "bi bi-buildings",
            ActionText = "Register Corporate Account",
            ActionUrl = Url.Action("Upsert", "Company", new { area = "Admin" })
        };
        <partial name="_EmptyState" model="@emptyState" />
    }
</div>

@section Scripts {
    <script src="~/js/Company.js" asp-append-version="true"></script>
}
