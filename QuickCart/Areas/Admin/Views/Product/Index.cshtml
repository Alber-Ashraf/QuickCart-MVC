@model IEnumerable<Product>
@using QuickCart.Models.ViewModels

@{
    ViewData["Title"] = "Product Catalog";
    var pageHeader = new PageHeaderVM
    {
        Title = "Product Catalog",
        Subtitle = "Manage published inventory, volume pricing tiers, and media assets.",
        IconClass = "bi bi-box-seam",
        ActionText = "New Product",
        ActionUrl = Url.Action("Upsert", "Product", new { area = "Admin" }),
        ActionIcon = "bi bi-plus-lg"
    };
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Product" asp-action="Index">Inventory</a>
    <span class="separator">/</span>
    <span class="current">Products</span>
}

<div class="product-management-container py-2">
    <partial name="_PageHeader" model="@pageHeader" />

    @if (Model != null && Model.Any())
    {
        <div class="qc-card overflow-hidden">
            <div class="p-3 bg-surface-hover border-bottom border-subtle d-flex justify-content-between align-items-center">
                <span class="small fw-bold text-uppercase text-muted letter-spacing-wide">
                    <i class="bi bi-table me-1 text-primary"></i> Inventory Records
                </span>
                <span class="small text-muted font-mono">Live DataTables feed</span>
            </div>

            <div class="p-3">
                <div class="table-responsive">
                    <table id="tblData" class="qc-table w-100">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>ISBN</th>
                                <th>Price</th>
                                <th>Category</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Populated asynchronously by product.js via /Admin/Product/GetAll -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        var emptyState = new EmptyStateVM
        {
            Title = "No products found",
            Description = "Your product inventory is currently empty. Get started by adding your first product to the catalog.",
            IconClass = "bi bi-box-seam",
            ActionText = "Create New Product",
            ActionUrl = Url.Action("Upsert", "Product", new { area = "Admin" })
        };
        <partial name="_EmptyState" model="@emptyState" />
    }
</div>

@section Scripts {
    <script src="~/js/product.js" asp-append-version="true"></script>
}
