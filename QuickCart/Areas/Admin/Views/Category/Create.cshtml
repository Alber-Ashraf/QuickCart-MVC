@model Category

@{
    ViewData["Title"] = "Create Category";
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Category" asp-action="Index">Taxonomy</a>
    <span class="separator">/</span>
    <span class="current">New Category</span>
}

<div class="category-form-container py-2 d-flex justify-content-center">
    <div class="qc-card p-4 p-md-5" style="max-width: 600px; width: 100%;">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="empty-state-icon-circle bg-primary-subtle text-primary" style="width: 48px; height: 48px;">
                <i class="bi bi-folder-plus fs-4"></i>
            </div>
            <div>
                <h1 class="fs-5 fw-bold text-primary mb-1">Create Category</h1>
                <p class="small text-muted mb-0">Define a new catalog taxonomy and display sequence.</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label small fw-semibold text-secondary">
                    Category Name <span class="text-danger">*</span>
                </label>
                <div class="input-icon-group">
                    <i class="bi bi-tag input-prefix-icon"></i>
                    <input asp-for="Name" class="form-control qc-input" placeholder="e.g. Science Fiction & Fantasy" autofocus />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DisplayOrder" class="form-label small fw-semibold text-secondary">
                    Display Order Sequence <span class="text-danger">*</span>
                </label>
                <div class="input-icon-group">
                    <i class="bi bi-sort-numeric-down input-prefix-icon"></i>
                    <input asp-for="DisplayOrder" class="form-control qc-input font-mono" placeholder="e.g. 1, 2, 3..." />
                </div>
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                <div class="form-text small text-muted">Controls navigation ordering on the customer storefront.</div>
            </div>

            <div class="d-flex gap-2 justify-content-end pt-3 border-top border-subtle">
                <a asp-action="Index" class="btn btn-outline-secondary qc-btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary qc-btn-primary" data-loading-text="Creating...">
                    <i class="bi bi-check2 me-1"></i> Save Category
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
