@model IEnumerable<Category>
@using QuickCart.Models.ViewModels

@{
    ViewData["Title"] = "Categories";
    var pageHeader = new PageHeaderVM
    {
        Title = "Categories",
        Subtitle = "Organize storefront inventory into classification taxonomy and navigation hierarchy.",
        IconClass = "bi bi-folder2-open",
        ActionText = "New Category",
        ActionUrl = Url.Action("Create", "Category", new { area = "Admin" }),
        ActionIcon = "bi bi-plus-lg"
    };
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Category" asp-action="Index">Taxonomy</a>
    <span class="separator">/</span>
    <span class="current">Categories</span>
}

<div class="category-management-container py-2">
    <partial name="_PageHeader" model="@pageHeader" />

    @if (Model != null && Model.Any())
    {
        <div class="qc-card overflow-hidden">
            <div class="p-3 bg-surface-hover border-bottom border-subtle d-flex justify-content-between align-items-center">
                <span class="small fw-bold text-uppercase text-muted letter-spacing-wide">
                    <i class="bi bi-list-nested me-1 text-primary"></i> Defined Taxonomies (@Model.Count())
                </span>
                <span class="small text-muted font-mono">Sorted by Display Sequence</span>
            </div>

            <div class="p-0">
                <div class="table-responsive">
                    <table class="qc-table w-100 mb-0">
                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th class="text-center" style="width: 180px;">Display Sequence</th>
                                <th class="text-end" style="width: 200px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var obj in Model.OrderBy(u => u.DisplayOrder))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="qc-badge qc-badge-accent">
                                                <i class="bi bi-tag-fill me-1"></i>
                                            </span>
                                            <span class="fw-semibold text-primary">@obj.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="qc-badge qc-badge-muted font-mono fw-bold">
                                            #@obj.DisplayOrder
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1" role="group">
                                            <a asp-action="Edit" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-secondary qc-btn-secondary" title="Edit Category">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-danger" title="Delete Category">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        var emptyState = new EmptyStateVM
        {
            Title = "No categories defined",
            Description = "Your taxonomy list is currently empty. Create categories to help customers navigate your catalog.",
            IconClass = "bi bi-folder-x",
            ActionText = "Create New Category",
            ActionUrl = Url.Action("Create", "Category", new { area = "Admin" })
        };
        <partial name="_EmptyState" model="@emptyState" />
    }
</div>
