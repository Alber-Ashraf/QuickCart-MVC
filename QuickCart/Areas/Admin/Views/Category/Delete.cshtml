@model Category

@{
    ViewData["Title"] = $"Delete Category: {Model.Name}";
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Category" asp-action="Index">Taxonomy</a>
    <span class="separator">/</span>
    <span class="current">Delete Category</span>
}

<div class="category-delete-container py-2 d-flex justify-content-center">
    <div class="qc-card p-4 p-md-5" style="max-width: 600px; width: 100%;">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="empty-state-icon-circle bg-danger-subtle text-danger" style="width: 48px; height: 48px;">
                <i class="bi bi-exclamation-triangle fs-4"></i>
            </div>
            <div>
                <h1 class="fs-5 fw-bold text-danger mb-1">Delete Category</h1>
                <p class="small text-muted mb-0">Review category details before permanent deletion.</p>
            </div>
        </div>

        <div class="p-3 bg-danger-subtle border border-danger-subtle rounded-2 text-danger small mb-4">
            <i class="bi bi-exclamation-octagon me-1 fw-bold"></i>
            <strong>Warning:</strong> Deleting this category may affect products assigned to it. This action cannot be reversed.
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label small fw-semibold text-muted">Category Name</label>
                <input asp-for="Name" class="form-control qc-input" disabled />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold text-muted">Display Order</label>
                <input asp-for="DisplayOrder" class="form-control qc-input font-mono" disabled />
            </div>

            <div class="d-flex gap-2 justify-content-end pt-3 border-top border-subtle">
                <a asp-action="Index" class="btn btn-outline-secondary qc-btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-danger" data-loading-text="Deleting...">
                    <i class="bi bi-trash3 me-1"></i> Confirm Deletion
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
