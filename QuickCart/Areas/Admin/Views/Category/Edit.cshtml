@model Category

@{
    ViewData["Title"] = $"Edit Category: {Model.Name}";
}

@section Breadcrumbs {
    <a asp-area="Admin" asp-controller="Category" asp-action="Index">Taxonomy</a>
    <span class="separator">/</span>
    <span class="current">Edit Category</span>
}

<div class="category-form-container py-2 d-flex justify-content-center">
    <div class="qc-card p-4 p-md-5" style="max-width: 600px; width: 100%;">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="empty-state-icon-circle bg-primary-subtle text-primary" style="width: 48px; height: 48px;">
                <i class="bi bi-pencil-square fs-4"></i>
            </div>
            <div>
                <h1 class="fs-5 fw-bold text-primary mb-1">Edit Category</h1>
                <p class="small text-muted mb-0">Modify taxonomy naming or display ordering.</p>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label small fw-semibold text-secondary">
                    Category Name <span class="text-danger">*</span>
                </label>
                <div class="input-icon-group">
                    <i class="bi bi-tag input-prefix-icon"></i>
                    <input asp-for="Name" class="form-control qc-input" placeholder="Category Name" autofocus />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="DisplayOrder" class="form-label small fw-semibold text-secondary">
                    Display Order Sequence <span class="text-danger">*</span>
                </label>
                <div class="input-icon-group">
                    <i class="bi bi-sort-numeric-down input-prefix-icon"></i>
                    <input asp-for="DisplayOrder" class="form-control qc-input font-mono" placeholder="Display Order" />
                </div>
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 justify-content-end pt-3 border-top border-subtle">
                <a asp-action="Index" class="btn btn-outline-secondary qc-btn-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary qc-btn-primary" data-loading-text="Updating...">
                    <i class="bi bi-check2 me-1"></i> Update Category
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
