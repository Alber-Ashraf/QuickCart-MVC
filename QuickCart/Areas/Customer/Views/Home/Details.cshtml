@model ShoppingCart

@{
    ViewData["Title"] = Model.Product.Title;
    var images = Model.Product.ProductImages?.ToList() ?? new List<ProductImage>();
    var primaryImage = images.FirstOrDefault()?.ImageUrl;
}

@section Breadcrumbs {
    <a asp-action="Index">Storefront</a>
    <span class="separator">/</span>
    <span class="current text-truncate" style="max-width: 200px;">@Model.Product.Title</span>
}

<div class="product-details-container py-2">
    <!-- Action Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary qc-btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Catalog
        </a>
        <div class="d-flex align-items-center gap-2">
            <span class="qc-badge qc-badge-accent">
                <i class="bi bi-tag-fill me-1"></i> @(Model.Product.Category?.Name ?? "General")
            </span>
            @if (!string.IsNullOrEmpty(Model.Product.ISBN))
            {
                <span class="qc-badge qc-badge-muted font-mono">
                    ISBN: @Model.Product.ISBN
                </span>
            }
        </div>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />

        <div class="row g-4">
            <!-- Left: Product Artwork Showcase -->
            <div class="col-lg-5">
                <div class="qc-card p-4 text-center sticky-top" style="top: 80px;">
                    <div class="p-3 bg-subtle rounded-3 d-flex align-items-center justify-content-center mb-3" style="min-height: 400px;">
                        @if (!string.IsNullOrEmpty(primaryImage))
                        {
                            <img src="@primaryImage"
                                 id="mainProductArtwork"
                                 alt="@Model.Product.Title"
                                 class="img-fluid rounded-2 shadow-sm"
                                 style="max-height: 380px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-book fs-1 mb-2"></i>
                                <p class="small font-mono">Flyleaf Verified Edition</p>
                            </div>
                        }
                    </div>

                    <!-- Multiple Image Thumbnails -->
                    @if (images.Count > 1)
                    {
                        <div class="d-flex gap-2 justify-content-center overflow-auto py-2">
                            @foreach (var img in images)
                            {
                                <button type="button"
                                        class="p-1 border border-subtle rounded-2 bg-surface cursor-pointer thumbnail-btn"
                                        onclick="document.getElementById('mainProductArtwork').src = '@img.ImageUrl'">
                                    <img src="@img.ImageUrl" alt="Thumbnail" style="width: 50px; height: 50px; object-fit: cover;" class="rounded-1" />
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Product Specifications & Purchase Card -->
            <div class="col-lg-7">
                <div class="qc-card p-4 p-md-5 mb-4">
                    <h1 class="display-6 fw-bold text-primary mb-2">@Model.Product.Title</h1>
                    <p class="fs-6 text-muted mb-4">
                        Authored by <span class="fw-semibold text-secondary">@Model.Product.Author</span>
                    </p>

                    <!-- Tiered Wholesale Volume Pricing Matrix -->
                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold letter-spacing-wide d-block mb-2">
                            <i class="bi bi-layers-fill me-1 text-primary"></i> Tiered Volume Pricing Matrix
                        </label>
                        <div class="table-responsive">
                            <table class="qc-table text-center border rounded-2">
                                <thead>
                                    <tr>
                                        <th>Quantity Tier</th>
                                        <th>Unit Price</th>
                                        <th>Wholesale Savings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="fw-medium">1 – 50 Units</td>
                                        <td class="font-mono fw-bold text-primary">@Model.Product.Price.ToString("C")</td>
                                        <td><span class="qc-badge qc-badge-muted">Base Tier</span></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-medium">51 – 100 Units</td>
                                        <td class="font-mono fw-bold text-success">@Model.Product.Price50.ToString("C")</td>
                                        <td>
                                            @if (Model.Product.Price > Model.Product.Price50)
                                            {
                                                var save50 = Math.Round(((Model.Product.Price - Model.Product.Price50) / Model.Product.Price) * 100);
                                                <span class="qc-badge qc-badge-success">Save @save50%</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-medium">100+ Units (Bulk)</td>
                                        <td class="font-mono fw-bold text-success">@Model.Product.Price100.ToString("C")</td>
                                        <td>
                                            @if (Model.Product.Price > Model.Product.Price100)
                                            {
                                                var save100 = Math.Round(((Model.Product.Price - Model.Product.Price100) / Model.Product.Price) * 100);
                                                <span class="qc-badge qc-badge-success">Save @save100%</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Description Section -->
                    <div class="mb-4">
                        <label class="small text-muted text-uppercase fw-bold letter-spacing-wide d-block mb-2">
                            Product Description
                        </label>
                        <div class="text-secondary lh-lg" style="white-space: pre-line;">
                            @Model.Product.Description
                        </div>
                    </div>

                    <hr class="border-subtle my-4" />

                    <!-- Quantity Input & Purchase Action Bar -->
                    <div class="row g-3 align-items-center">
                        <div class="col-sm-5">
                            <label asp-for="Count" class="form-label small fw-semibold text-muted">
                                Quantity (1 - 1000)
                            </label>
                            <div class="input-icon-group">
                                <i class="bi bi-calculator input-prefix-icon"></i>
                                <input asp-for="Count"
                                       type="number"
                                       min="1"
                                       max="1000"
                                       class="form-control qc-input font-mono fw-bold text-center"
                                       value="@(Model.Count < 1 ? 1 : Model.Count)" />
                            </div>
                            <span asp-validation-for="Count" class="text-danger small"></span>
                        </div>

                        <div class="col-sm-7 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary qc-btn-primary w-100 py-2 justify-content-center" data-loading-text="Adding to Cart...">
                                <i class="bi bi-cart-plus me-2"></i> Add to Shopping Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
