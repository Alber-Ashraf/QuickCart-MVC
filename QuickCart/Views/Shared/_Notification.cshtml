@*
    XSS-safe Toastr notification receiver.
    Values are consumed and safely escaped by wwwroot/js/site.js.
*@
@if (TempData["success"] != null || TempData["error"] != null || TempData["warning"] != null || TempData["info"] != null)
{
    <div id="toast-notifications"
         data-success="@TempData["success"]"
         data-error="@TempData["error"]"
         data-warning="@TempData["warning"]"
         data-info="@TempData["info"]"
         class="d-none"
         aria-hidden="true">
    </div>
}

<!-- WCAG 2.2 AA Screen Reader Announcement Live Region -->
<div id="qc-live-announcer"
     class="visually-hidden"
     aria-live="polite"
     aria-atomic="true"
     role="status">
</div>
