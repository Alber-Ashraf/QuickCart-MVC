@model ErrorViewModel
@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "System Error";
}

<div class="mb-4">
    <div class="empty-state-icon-circle mx-auto bg-danger-subtle text-danger" style="width: 72px; height: 72px;">
        <i class="bi bi-exclamation-triangle-fill fs-2"></i>
    </div>
</div>

<h2 class="fw-bold text-primary mb-2">Something went wrong</h2>
<p class="text-muted mb-4">
    An unexpected error occurred while processing your request. Our engineering team has been notified.
</p>

@if (Model.ShowRequestId)
{
    <div class="p-3 bg-surface-hover rounded-3 border border-subtle mb-4 text-start">
        <span class="text-muted small text-uppercase fw-semibold d-block">Trace / Request ID</span>
        <code class="font-mono text-primary fs-6">@Model.RequestId</code>
    </div>
}

<div class="d-flex justify-content-center gap-3">
    <a href="javascript:history.back()" class="btn btn-outline-secondary qc-btn-secondary">
        <i class="bi bi-arrow-left me-1"></i> Go Back
    </a>
    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary qc-btn-primary">
        <i class="bi bi-house-door me-1"></i> Return to Safety
    </a>
</div>
